# HUGGINGFACE_API_KEY / HF_TOKEN: Optional for Open-Source LLMs (Llama 3, Mistral, Qwen) via Hugging Face Inference API
HUGGINGFACE_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CLOUDINARY CONFIGURATION (Production Media CDN Storage)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_URL=""

# STOCK IMAGE API KEYS (For automated image import & enrichment pipeline)
UNSPLASH_ACCESS_KEY=""
PEXELS_API_KEY=""
PIXABAY_API_KEY=""
